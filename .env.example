# Supabase project credentials.
# Get these from the Supabase dashboard: Settings → API → Project URL / Project API Keys.

# Safe to ship to the browser. Used by Server Components, the browser bundle,
# and middleware to read/write auth cookies.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# NEVER expose this. It bypasses RLS. We'll use it server-side only,
# in the WhatsApp webhook handler (Phase 4). Not consumed in Phase 2.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY


# Interakt (WhatsApp BSP) — outbound template sends.
# The Secret Key from the Interakt dashboard: Settings → Developer Setting →
# Secret Key. It is passed VERBATIM as the HTTP Basic auth credential
# ("Authorization: Basic <key>") — we do NOT base64-encode it ourselves.
# Server-side only; never expose to the browser.
INTERAKT_API_KEY=YOUR_INTERAKT_SECRET_KEY

# Default dialing code used to split a trucker's stored E.164 phone
# (e.g. +919876543210) into Interakt's separate countryCode + phoneNumber
# fields. Ramnath's truckers are India-based, so "+91". Include the leading
# "+". Numbers under any other code are skipped (and logged) rather than
# guessed. If unset, the code defaults to "+91".
WHATSAPP_DEFAULT_COUNTRY_CODE=+91

# Our Interakt WhatsApp business number in E.164 (e.g. +911234567890). Logged
# as whatsapp_messages.from_phone on outbound rows and as to_phone on inbound
# rows. Optional — if unset, from_phone is logged as null (no crash).
WHATSAPP_FROM=YOUR_WHATSAPP_BUSINESS_NUMBER_E164

# Shared secret for verifying inbound webhook calls from Interakt. The webhook
# computes SHA256-HMAC of the raw request body with this key and compares it
# (constant-time) to the "Interakt-Signature: sha256=<hex>" header. Set the
# SAME value here and in Interakt's webhook configuration. If unset, the
# webhook rejects every call with 401 (fail closed).
INTERAKT_WEBHOOK_SECRET=YOUR_INTERAKT_WEBHOOK_SECRET
