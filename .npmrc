# Don't auto-run `pnpm install` before every `pnpm <script>`. pnpm 11 enabled
# this by default, and it surfaces the harmless "ignored build scripts" warning
# for sharp / unrs-resolver as a fatal exit code, blocking `pnpm dev`.
# The warning itself stays — to silence it permanently, run `pnpm approve-builds`.
verify-deps-before-run=false
